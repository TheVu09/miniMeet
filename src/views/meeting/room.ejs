<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= meeting.title %> - miniMeet
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/meeting.css" />
</head>

<body>
    <!-- Preview Modal (shown before joining) -->
    <div class="modal fade" id="previewModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">Ready to join?</h5>
                </div>
                <div class="modal-body text-center">
                    <div class="position-relative d-inline-block" style="width: 640px; max-width: 100%;">
                        <video id="preview-video" autoplay muted playsinline class="w-100 rounded bg-black"
                            style="max-height: 480px;"></video>
                        <div id="preview-off-message"
                            class="position-absolute top-50 start-50 translate-middle text-white d-none">
                            <i class="bi bi-camera-video-off" style="font-size: 4rem;"></i>
                            <p class="mt-2">Camera is off</p>
                        </div>
                    </div>
                    <div class="mt-4 d-flex justify-content-center gap-3">
                        <button class="btn btn-lg btn-outline-light rounded-circle" id="preview-toggle-camera"
                            style="width: 60px; height: 60px;">
                            <i class="bi bi-camera-video" id="preview-camera-icon"></i>
                        </button>
                        <button class="btn btn-lg btn-outline-light rounded-circle" id="preview-toggle-mic"
                            style="width: 60px; height: 60px;">
                            <i class="bi bi-mic" id="preview-mic-icon"></i>
                        </button>
                    </div>
                    <p class="mt-3 text-muted">
                        <i class="bi bi-info-circle"></i> You can change these settings anytime during the meeting
                    </p>
                </div>
                <div class="modal-footer border-secondary justify-content-center">
                    <button type="button" class="btn btn-primary btn-lg px-5" id="join-meeting-btn">
                        <i class="bi bi-box-arrow-in-right"></i> Join now
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="meeting-container" class="d-flex flex-column vh-100" style="display: none !important;">
        <!-- Top Bar -->
        <div class="bg-dark text-white p-2">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">
                        <%= meeting.title %>
                    </h5>
                    <small>Code: <%= meeting.meetingCode %></small>
                </div>
                <div class="d-flex align-items-center">
                    <!-- Layout selector (manual override) -->
                    <select id="layout-select" class="form-select form-select-sm me-2" style="width: 150px;">
                        <option value="auto" selected>Auto</option>
                        <option value="tiled">Grid</option>
                        <option value="spotlight">Spotlight</option>
                        <option value="sidebar">Sidebar</option>
                    </select>

                    <button class="btn btn-sm btn-outline-light me-2" id="toggle-chat">
                        <i class="bi bi-chat"></i> Chat
                    </button>
                    <button class="btn btn-sm btn-outline-light me-2" id="toggle-participants">
                        <i class="bi bi-people"></i> Participants
                    </button>
                    <% if (isHost || isCoHost) { %>
                        <button class="btn btn-sm btn-outline-light me-2" id="toggle-settings">
                            <i class="bi bi-gear"></i> Settings
                        </button>
                        <% } %>
                            <a href="/meeting" class="btn btn-sm btn-danger">
                                <i class="bi bi-box-arrow-right"></i> Leave
                            </a>
                </div>
            </div>
            <div id="meeting-alert" class="alert alert-warning text-dark mb-0 py-1 px-2 d-none mt-2"></div>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 d-flex" style="min-height: 0; overflow: hidden;">
            <!-- Video Grid -->
            <div id="video-container" class="flex-grow-1 p-2 bg-dark" style="min-height: 0;">
                <div id="video-grid" class="video-grid-google-meet">
                    <!-- Videos will be added here dynamically -->
                </div>

                <div id="whiteboard-overlay" class="whiteboard-overlay">
                    <div class="whiteboard-toolbar text-white w-100">
                        <strong class="me-2"><i class="bi bi-pencil-square"></i> Whiteboard</strong>
                        <% if (isHost || isCoHost) { %>
                            <div class="btn-group me-2" role="group" aria-label="Whiteboard tools">
                                <button type="button" id="whiteboard-tool-pen"
                                    class="btn btn-sm btn-light btn-tool active" data-tool="pen">
                                    <i class="bi bi-pencil"></i> Pen
                                </button>
                                <button type="button" id="whiteboard-tool-eraser" class="btn btn-sm btn-light btn-tool"
                                    data-tool="eraser">
                                    <i class="bi bi-eraser"></i> Eraser
                                </button>
                            </div>
                            <label class="me-2">Color
                                <input type="color" id="whiteboard-color" value="#ff4757" class="ms-1">
                            </label>
                            <label class="me-2">Size
                                <select id="whiteboard-size" class="ms-1">
                                    <option value="2">Thin</option>
                                    <option value="4" selected>Normal</option>
                                    <option value="8">Thick</option>
                                </select>
                            </label>
                            <button type="button" id="whiteboard-clear" class="btn btn-sm btn-danger"><i
                                    class="bi bi-eraser"></i> Clear</button>
                            <button type="button" id="whiteboard-hide" class="btn btn-sm btn-secondary ms-auto"><i
                                    class="bi bi-x"></i> Hide</button>
                            <% } else { %>
                                <span class="ms-3 text-muted">Host is sharing a whiteboard</span>
                                <% } %>
                    </div>
                    <canvas id="whiteboard-canvas"></canvas>
                </div>
            </div>

            <!-- Sidebar -->
            <div id="sidebar" class="bg-light border-start" style="width: 350px; display: none;">
                <!-- Chat Panel -->
                <div id="chat-panel" class="d-flex flex-column h-100">
                    <div class="p-3 border-bottom">
                        <h5><i class="bi bi-chat"></i> Chat</h5>
                    </div>
                    <div id="chat-messages" class="flex-grow-1 p-3 overflow-auto" style="max-height: 400px;">
                        <!-- Messages will appear here -->
                    </div>
                    <div class="p-3 border-top">
                        <div class="input-group">
                            <input type="text" id="chat-input" class="form-control" placeholder="Type a message...">
                            <button class="btn btn-primary" id="send-chat">
                                <i class="bi bi-send"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Participants Panel -->
                <div id="participants-panel" class="d-none d-flex flex-column h-100">
                    <div class="p-3 border-bottom">
                        <h5><i class="bi bi-people"></i> Participants</h5>
                    </div>
                    <div id="participants-list" class="flex-grow-1 p-3 overflow-auto">
                        <!-- Participants will appear here -->
                    </div>
                </div>

                <!-- Q&A Panel -->
                <div id="qa-panel" class="d-none d-flex flex-column h-100">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-question-circle"></i> Q&A</h5>
                        <button class="btn btn-sm btn-outline-secondary" id="close-qa-panel">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                    <div id="qa-content" class="flex-grow-1 p-3 overflow-auto">
                        <!-- Q&A content -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Controls Bar -->
        <div class="bg-dark text-white p-3 d-flex justify-content-center align-items-center gap-3">
            <button class="btn btn-sm btn-secondary" id="toggle-mic">
                <i class="bi bi-mic"></i>
            </button>
            <button class="btn btn-sm btn-secondary" id="toggle-camera">
                <i class="bi bi-camera-video"></i>
            </button>
            <button class="btn btn-sm btn-secondary" id="toggle-screen-share">
                <i class="bi bi-display"></i>
            </button>
            <% if (isHost || isCoHost) { %>
                <button class="btn btn-sm btn-secondary" id="toggle-whiteboard">
                    <i class="bi bi-pencil-square"></i>
                </button>
                <% } %>
                    <button class="btn btn-sm btn-secondary" id="raise-hand">
                        <i class="bi bi-hand-raised"></i>
                    </button>
                    <button class="btn btn-sm btn-secondary" id="show-reactions">
                        <i class="bi bi-emoji-smile"></i>
                    </button>
                    <button class="btn btn-sm btn-secondary" id="show-polls">
                        <i class="bi bi-bar-chart"></i> Polls
                    </button>
                    <button class="btn btn-sm btn-secondary" id="show-qa">
                        <i class="bi bi-question-circle"></i> Q&A
                    </button>
                    <% if (isHost || isCoHost) { %>
                        <button class="btn btn-sm btn-warning" id="create-breakout">
                            <i class="bi bi-diagram-3"></i> Breakout Rooms
                        </button>
                        <% } %>
                            <% if (isHost) { %>
                                <button class="btn btn-sm btn-danger" id="end-meeting">
                                    <i class="bi bi-x-circle"></i> End Meeting
                                </button>
                                <% } %>
        </div>
    </div>

    <!-- libs -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <script>
        const meetingId = '<%= meeting._id %>';
        const userId = '<%= user._id %>';
        const isHost = <%= isHost %>;
        const isCoHost = <%= isCoHost %>;
    </script>

    <!-- layout manager + app scripts -->
    <script src="/js/videoLayoutManager.js"></script>

    <!-- keep other app scripts (webrtc, meeting logic) loaded after) -->
    <script src="/js/meeting.js"></script>
    <script src="/js/webrtc.js"></script>
    <script src="/js/polls.js"></script>
    <script src="/js/qa.js"></script>
    <script src="/js/breakout.js"></script>
</body>

</html>